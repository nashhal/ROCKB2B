# Demo V1 runs with synthetic browser-local data.
# Production secrets belong in the hosting provider's encrypted environment store.
DATABASE_URL=
SESSION_SECRET=
PRIVATE_FILE_STORAGE_URL=
ZATCA_PROVIDER_BASE_URL=
ZATCA_CLIENT_ID=
ZATCA_CLIENT_SECRET=

# Optional: Vercel AI Gateway model selection (default: openai/gpt-5.4-mini)
ROCK_AI_MODEL=openai/gpt-5.4-mini
# If Vercel OIDC is not available, store an encrypted AI Gateway key in the hosting environment.
AI_GATEWAY_API_KEY=
